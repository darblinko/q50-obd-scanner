# Environment variables q50diag reads. The app does not load this file;
# export the variables in your shell or CI configuration.
#
# The MechanIQ API key is not read from the environment. Enter it in
# MechanIQ settings; it is stored in ~/.config/q50diag/mechaniq.json with
# mode 0600. ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN from the environment
# are not passed to the agent process (q50diag/mechaniq/settings.py, child_env).

# Qt platform plugin. Set to offscreen for tests and headless smoke runs.
QT_QPA_PLATFORM=offscreen

# Packaged builds only: folder that holds the editable app source and logs.
# Default: %LOCALAPPDATA%\q50diag on Windows, ~/Library/Application Support/q50diag
# on macOS, $XDG_DATA_HOME/q50diag or ~/.local/share/q50diag elsewhere.
# Q50DIAG_HOME=

# PyInstaller build only: build stamp. Default: git short hash and UTC time.
# Q50DIAG_BUILD_ID=
